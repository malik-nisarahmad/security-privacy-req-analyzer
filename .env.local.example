# =============================================
# SPRAT — Environment Variables
# =============================================
# Copy this file to .env.local and fill in the values.
#
# HOW TO GET THESE VALUES:
# 1. Go to https://supabase.com and create a free account
# 2. Create a new project (any region)
# 3. Go to Project Settings → API
# 4. Copy the URL, anon key, and service_role key below
# =============================================

# Supabase project URL (from Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous/public key (from Settings → API → anon/public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (from Settings → API → service_role)
# WARNING: This key bypasses RLS. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
